<library path="rviz_msg_plugins">
  <!--
    One <class> per display. `type` is the fully-qualified C++ class (must match
    PLUGINLIB_EXPORT_CLASS in the .cpp). `base_class_type` is always
    rviz_common::Display for an RViz display plugin. `name` is what RViz shows in
    Add > By display type, grouped by the path before the slash.
  -->

  <class
    name="rviz_msg_plugins/LivoxCustomMsg"
    type="rviz_msg_plugins::LivoxCustomMsgDisplay"
    base_class_type="rviz_common::Display">
    <description>
      Visualizes livox_ros_driver2/msg/CustomMsg by converting it to PointCloud2
      inside RViz2. The frame is taken from the message header (livox_frame).
    </description>
    <message_type>livox_ros_driver2/msg/CustomMsg</message_type>
  </class>
</library>
