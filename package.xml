<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mmr_rviz_plugins</name>
  <version>0.1.0</version>
  <description>
    Custom RViz2 display plugins for MMR Driverless messages. Includes a
    SpeedProfile display for mmr_base/msg/SpeedProfilePoints, and documentation
    for authoring further displays.
  </description>
  <maintainer email="leo.nels.2000@gmail.com">leonardo</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>pluginlib</depend>
  <depend>rviz_common</depend>
  <depend>rviz_rendering</depend>
  <depend>rviz_default_plugins</depend>
  <depend>geometry_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>mmr_base</depend>
  <depend>qtbase5-dev</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- Registers this package's displays with RViz at runtime. -->
    <rviz plugin="${prefix}/plugins_description.xml"/>
  </export>
</package>
